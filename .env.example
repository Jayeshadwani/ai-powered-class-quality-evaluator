# Copy to .env and enter your key. NEVER commit .env.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_DETAIL=low
OPENAI_TIMEOUT_SECONDS=180

# Transcription executes locally. CPU + int8 works on Mac and ordinary laptops.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_VAD_MIN_SILENCE_MS=500

# Agreed processing settings.
FRAME_INTERVAL_SECONDS=10
BATCH_DURATION_SECONDS=120
FRAME_WIDTH=640
MAX_DURATION_MINUTES=60
MAX_UPLOAD_MB=1024

# Confidential local artifacts: JSON, not source video/audio/frames.
RUNS_DIR=./runs
SAVE_RESULTS=true
API_URL=http://127.0.0.1:8000
